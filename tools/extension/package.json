{
  "name": "poctra-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "icons": "node scripts/generate-icons.mjs",
    "build": "npm run icons && tsc -b && vite build",
    "qa:visual": "node scripts/visual-qa.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "1.8.1",
    "@noble/hashes": "1.7.1",
    "@scure/bip39": "1.5.4",
    "ethers": "6.17.0",
    "lucide-preact": "0.468.0",
    "preact": "10.25.4",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "0.0.287",
    "@types/qrcode": "1.5.5",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
